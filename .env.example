# ─── Server-side (required) ──────────────────────────────────────────────────
# Used by the /api/generate serverless function for BOTH image generation and
# model moderation. NOT prefixed with VITE_, so Vite never inlines it into the
# client bundle.
#
# Set this in the Vercel dashboard (Project → Settings → Environment Variables)
# for the deployment at https://card-image-nishant-dash.vercel.app/.
GEMINI_API_KEY=

# ─── Model moderation ────────────────────────────────────────────────────────
# Which classifier scores the prompt, the uploaded photo and the generated
# artwork. Default "gemini" reuses GEMINI_API_KEY above, so no extra credential
# is needed and moderation is on as soon as generation works.
#
#   gemini       text + image. Reuses GEMINI_API_KEY.
#   openai       text + image via omni-moderation-latest. Needs OPENAI_API_KEY.
#                No celebrity/trademark/political notion — the blocklist covers those.
#   huggingface  text only. Needs HF_TOKEN. Cannot classify images, and reports
#                image moderation as unavailable rather than passing.
# MODERATION_PROVIDER=gemini

# OPENAI_API_KEY=
# HF_TOKEN=
# HF_MODERATION_MODEL=KoalaAI/Text-Moderation

# Per-classification timeout. On timeout the request fails CLOSED: it is routed
# to human review, never auto-approved, and never falsely rejected.
# MODERATION_TIMEOUT_MS=9000

# Classify generated images as well as inputs. Costs one extra classifier call
# per variation. Leave on: a clean prompt can still produce unsafe output, and
# with this off nothing ever inspects what the provider actually returned.
# MODERATE_OUTPUT_IMAGES=true

# Kill switch. With moderation disabled, image detectors report as unavailable,
# so no submission can auto-approve — everything lands in manual review.
# MODERATION_ENABLED=true

# ─── Ops queue storage (recommended for shared/public demos) ──────────────────
# The review queue is server state so every visitor sees the same items and they
# survive a reload. Add Vercel's Upstash / KV integration to the project and these
# two variables are injected automatically — no code change needed:
#
#   Vercel dashboard -> Storage -> Create -> Upstash for Redis -> connect project
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Without them the queue falls back to per-instance memory: submissions vanish on
# redeploy and two visitors may see different queues. The fallback is NOT silent —
# the API reports storage:"memory" and the ops dashboard shows a warning.

# Secret for signing verdict tokens, which let /api/submissions trust the
# moderation decision without re-running the classifier. Optional: defaults to a
# hash derived from GEMINI_API_KEY, which is stable across instances. Set it
# explicitly if you rotate the Gemini key and do not want existing tokens voided.
# SUBMISSION_SECRET=

# ─── Client-side (optional, local development only) ───────────────────────────
# Lets `vite dev` call the image provider directly when no serverless runtime is
# available. This path applies the blocklists but NOT model moderation, and its
# decision is made in the browser where it can be bypassed. Ignored in a
# production build (requires import.meta.env.DEV).
# VITE_ALLOW_DIRECT_PROVIDER=true

# A key for that direct-call path only. VITE_* vars are inlined into the PUBLIC
# bundle and readable in devtools — use a throwaway, restricted key, locally only.
# VITE_GEMINI_API_KEY=
